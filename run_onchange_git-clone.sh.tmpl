{{ if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
#!/bin/bash

set -e
set -x

ZSH_DIR="${ZSH:-$HOME/.oh-my-zsh}"

# Install oh-my-zsh first. Its installer replaces $ZSH_DIR wholesale, so cloning
# plugins before it exists silently loses them (this is what happened Jun 2026).
# KEEP_ZSHRC=yes is required or it overwrites the chezmoi-managed ~/.zshrc.
if [ ! -d "$ZSH_DIR" ]; then
    RUNZSH=no CHSH=no KEEP_ZSHRC=yes \
        sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
fi

ZSH_PLUGINS_DIR="${ZSH_CUSTOM:-$ZSH_DIR/custom}/plugins"
ZSH_THEMES_DIR="${ZSH_CUSTOM:-$ZSH_DIR/custom}/themes"
mkdir -p "$ZSH_PLUGINS_DIR" "$ZSH_THEMES_DIR"

# zsh-autosuggestions
if [ ! -d "$ZSH_PLUGINS_DIR/zsh-autosuggestions" ]; then
    git clone --depth 1 -- https://github.com/zsh-users/zsh-autosuggestions.git "$ZSH_PLUGINS_DIR/zsh-autosuggestions"
fi

# zsh-syntax-highlighting
if [ ! -d "$ZSH_PLUGINS_DIR/zsh-syntax-highlighting" ]; then
    git clone --depth 1 -- https://github.com/zsh-users/zsh-syntax-highlighting.git "$ZSH_PLUGINS_DIR/zsh-syntax-highlighting"
fi

# powerlevel10k (ZSH_THEME in dot_zshrc.tmpl)
if [ ! -d "$ZSH_THEMES_DIR/powerlevel10k" ]; then
    git clone --depth 1 -- https://github.com/romkatv/powerlevel10k.git "$ZSH_THEMES_DIR/powerlevel10k"
fi

{{ end -}}
